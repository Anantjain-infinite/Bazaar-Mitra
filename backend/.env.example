# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
#
# This file covers BOTH processes that run out of backend/:
#   - the FastAPI commerce API      (app/main.py)
#   - the LiveKit voice agent worker (src/agent.py)
# They share one .env.local so a session/order/payment looked up by voice
# and by the commerce API always hits the same database.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
AGENT_NAME=Bazaar Mitra
# Comma-separated list of origins the commerce API will accept browser requests from.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Local dev via docker-compose: postgresql+asyncpg://postgres:postgres@localhost:5432/bazaar_mitra
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bazaar_mitra

# -----------------------------------------------------------------------------
# Razorpay (Test Mode)
# See the "How to get Razorpay test-mode keys" walkthrough for the steps.
# Dashboard: https://dashboard.razorpay.com/ → switch to Test Mode →
# Account & Settings → API Keys → Generate Key
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Settings → Webhooks → Add New Webhook → set a secret, subscribe to
# payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -----------------------------------------------------------------------------
# Transaction policy defaults
# Used when a merchant/buyer has no explicit transaction_policies row.
# Amounts are in the smallest sane unit for the currency's display (i.e.
# plain rupees here, not paise) — see policy_service for the paise conversion
# done right before calling Razorpay.
# -----------------------------------------------------------------------------
MAX_TRANSACTION_AMOUNT=5000
DAILY_TRANSACTION_LIMIT=10000

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

